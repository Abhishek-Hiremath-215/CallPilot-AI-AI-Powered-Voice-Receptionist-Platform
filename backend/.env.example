# === AI Communication Platform Configuration ===
# Copy this file to .env and fill in your values

# OpenAI API Key (get free from https://aistudio.google.com/apikey)
OPENAI_API_KEY=your-gemini-api-key-here

# LLM Model
LLM_MODEL=gemini-2.0-flash

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/automation

# JWT Secret (generate a strong random string for production)
SECRET_KEY=change-this-to-a-random-secret-key

# Admin defaults
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
